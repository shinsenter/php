marker="/etc/.fix-ownership"

case "$1" in
marker) echo "$marker"; [ "$#" -eq 0 ] && exit 0 ;;
dirty)  touch "$marker" >/dev/null 2>&1 && exit 0 ;;
fix)    shift ;;
esac

if [ "$#" -eq 0 ]; then
    \rm -rf $marker
    set -- "$(app-path)"
fi

for target; do
    if keep-owner "$target"; then
        debug-echo "Keep ownership of $target."
    elif [ -n "$target" ] && [ -e "$target" ]; then
        debug-echo "Fix ownership for $target."
        # chown only what has a wrong owner: unchanged files cost a stat, not a write
        {
            find "$target" -type f \( ! -user "$APP_USER" -o ! -group "$APP_GROUP" \) \
                -exec chown -h "$APP_USER:$APP_GROUP" {} + &
            find "$target" -type d \( ! -user "$APP_USER" -o ! -group "$APP_GROUP" \) \
                -exec chown -h "$APP_USER:$APP_GROUP" {} + &
            wait
        } 2>/dev/null || chown -hR "$APP_USER:$APP_GROUP" "$target" 2>/dev/null || true
    fi
done
