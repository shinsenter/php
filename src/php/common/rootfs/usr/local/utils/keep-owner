# keep-owner <path>
# Exit 0 when DISABLE_AUTORUN_FIX_OWNER_GROUP is on and the path is inside the
# application directory or the document root, so no command may change its owner.

is-true "$DISABLE_AUTORUN_FIX_OWNER_GROUP" || exit 1

path="$(realpath -mqs "$1")/"
for base in "$(app-path)" "$(app-root)"; do
    base="$(realpath -mqs "$base")"
    case "$path" in "$base"/*) exit 0 ;; esac
done
exit 1
