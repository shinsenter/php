# keep-owner <path>
# Exit 0 when DISABLE_AUTORUN_FIX_OWNER_GROUP is on
# and the path is inside the application directory or the document root,
# so no command may change its owner.

# unset is the usual case: no is-true process
[ -n "$DISABLE_AUTORUN_FIX_OWNER_GROUP" ] || exit 1
is-true "$DISABLE_AUTORUN_FIX_OWNER_GROUP" || exit 1

# realpath only for relative paths and for . .. // or a trailing slash
norm() {
    case "$1" in
        /*/./*|/*/../*|/*//*|*/.|*/..|*/|[!/]*) REPLY="$(realpath -mqs "$1")" ;;
        *) REPLY="$1" ;;
    esac
}

norm "$1"; path="$REPLY/"
# the first base is app-path, without its process
for base in "${WEBHOME:-${APP_PATH:-/var/www/html}}" "$(app-root)"; do
    norm "$base"; base="$REPLY"
    case "$path" in "$base"/*) exit 0 ;; esac
done
exit 1
