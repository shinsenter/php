if [ "$#" -eq 0 ]; then exit 0; fi

run_cmd() {
    local script="$1"
    eval "set -- ${AUTORUN_ARGS:-}"
    if [ -x "$script" ]; then
        with-env "$script" "$@"
    fi
}

# one chmod for the *.sh files of a directory, none when the glob matches nothing
make_executable() {
    [ ! -e "$1" ] || chmod +x "$@" >/dev/null 2>&1
}

run_parts_args=""
if [ -n "$AUTORUN_ARGS" ]; then
    run_parts_args=$(
        eval "set -- ${AUTORUN_ARGS:-}"
        [ "$#" -gt 0 ] && printf ' --arg=%s' "$@"
    )
fi

for path; do
    if [ -n "$path" ] && [ -e "$path" ]; then
        # realpath only matters for relative paths and for . .. or // inside the path
        case "$path" in
            /*/./*|/*/../*|/*//*|*/.|*/..|[!/]*) path="$(realpath -mqs $path)" ;;
        esac
        if [ -d "$path" ]; then
            if command -v run-parts >/dev/null 2>&1; then
                make_executable "$path"/*.sh
                with-env run-parts --regex '.*' --new-session $run_parts_args -- "$path"
            else
                find $path -type f -name '*.sh' | xargs -r chmod +x >/dev/null 2>&1
                for script in $(find $path -type f -perm -111 | sort -dbfi); do
                    run_cmd "$script"
                done
            fi
        else
            run_cmd "$path"
        fi
    fi
done
