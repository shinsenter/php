# s6 runs this when the container stops, before the servers stop.
# The delay gives a load balancer time to remove this container from its pool.
delay="${SHUTDOWN_DELAY:-0}"

if [ "$delay" -gt 0 ] 2>/dev/null; then
    debug-echo -i "Wait ${delay}s before stopping the servers."
    sleep "$delay"
fi
