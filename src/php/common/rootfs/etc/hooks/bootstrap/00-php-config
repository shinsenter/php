# generate PHP config
if has-cmd php && has-cmd php-envvars; then
    debug-echo "Generate PHP config."
    if is-true "$ALLOW_RUNTIME_PHP_ENVVARS"; then
        debug-echo "Export all env variables for PHP."
        php-envvars export_envvars 2>&1
        php-envvars write_dynamic_config 2>&1
    else
        php-envvars write_static_config 2>&1
    fi
fi

# optimize PHP-FPM
if has-cmd php-fpm && is-true "$ENABLE_TUNING_FPM"; then
    debug-echo -i "Tune PHP-FPM performance."

    config_file="$(php-envvars fpm_conf)"
    mkdir -p "$(dirname "$config_file")"
    touch "$config_file"
    sed -i '/^; Tuning PM/,$d' "$config_file" 2>/dev/null || true

    # gather system info
    cpu_cores=$(container-limits cpu)

    # read scaling from env or fallback to defaults
    scale_children="${PHPFPM_SCALE_CHILDREN:-5}"
    scale_start="${PHPFPM_SCALE_START:-2}"
    scale_min_spare="${PHPFPM_SCALE_MIN_SPARE:-1}"
    scale_max_spare="${PHPFPM_SCALE_MAX_SPARE:-3}"
    max_requests="${PHPFPM_MAX_REQUESTS:-500}"

    # a value the user passed to the container wins: tuning only replaces the defaults
    user_set() { tr '\0' '\n' </proc/1/environ 2>/dev/null | grep -q "^$1="; }

    # calculate values
    [ "$scale_children" -gt 0 ] 2>/dev/null || scale_children=1
    pm="dynamic"
    pm_max_children=$((cpu_cores * scale_children))
    if user_set PHP_PM_MAX_CHILDREN && [ "$PHP_PM_MAX_CHILDREN" -gt 0 ] 2>/dev/null; then
        pm_max_children="$PHP_PM_MAX_CHILDREN"
    fi

    # the other values follow max_children, so start and spare servers never exceed it
    scaled() {
        local n=$((pm_max_children * $1 / scale_children))
        [ "$n" -ge 1 ] || n=1
        [ "$n" -le "$pm_max_children" ] || n="$pm_max_children"
        echo "$n"
    }
    pm_start_servers=$(scaled "$scale_start")
    pm_min_spare_servers=$(scaled "$scale_min_spare")
    pm_max_spare_servers=$(scaled "$scale_max_spare")

    tuned=""
    add_tuned() { user_set "PHP_$1" || tuned="$tuned$2 = $3"$'\n'; }
    add_tuned PM pm "$pm"
    add_tuned PM_MAX_CHILDREN pm.max_children "$pm_max_children"
    add_tuned PM_START_SERVERS pm.start_servers "$pm_start_servers"
    add_tuned PM_MIN_SPARE_SERVERS pm.min_spare_servers "$pm_min_spare_servers"
    add_tuned PM_MAX_SPARE_SERVERS pm.max_spare_servers "$pm_max_spare_servers"
    add_tuned PM_MAX_REQUESTS pm.max_requests "$max_requests"

    if [ -n "$tuned" ]; then
        cat <<EOF >> "$config_file"
; Tuning PM
[$(is-true "$ALLOW_RUNTIME_PHP_ENVVARS" && echo '${PHP_POOL_NAME}' || echo "${PHP_POOL_NAME}")]
$tuned
; Generated at $(date "+%Y-%m-%d %H:%M:%S")
EOF
    fi
fi

# load the custom-*.conf files last, so they win over the generated settings
# and the tuning. The other files in the directory are not loaded on purpose,
# they would override the PHP_* variables.
if has-cmd php-fpm && has-cmd php-envvars; then
    config_file="$(php-envvars fpm_conf)"
    if [ -f "$config_file" ]; then
        printf '\n; Custom pool files\ninclude=%s/custom-*.conf\n' "$(dirname "$config_file")" >> "$config_file"
    fi
fi
