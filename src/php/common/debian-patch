# Point Debian releases that deb.debian.org no longer serves to archive.debian.org.
# Used by common/os-common.dockerfile and common/php-backports.dockerfile (mounted
# from the build context, so it is not part of any image). Other systems are left alone.
# The change stays in the image: the next layers install packages too.

[ -d /etc/apt ] && [ -f /etc/os-release ] || exit 0
. /etc/os-release
major="${VERSION_ID%%.*}"
[ "$ID" = debian ] && [ "${major:-99}" -lt 12 ] || exit 0

files="/etc/apt/sources.list /etc/apt/sources.list.d/*"
# shellcheck disable=SC2086
sed -i \
    -e '/stretch-updates/d' \
    -e 's|://deb.debian.org/debian-security|://archive.debian.org/debian-security|g' \
    -e 's|://security.debian.org/debian-security|://archive.debian.org/debian-security|g' \
    -e 's|://deb.debian.org/debian|://archive.debian.org/debian|g' \
    $files 2>/dev/null || true
echo 'Acquire::Check-Valid-Until "false";' >/etc/apt/apt.conf.d/99-archive

# the signing keys of the oldest releases have expired
if [ "$major" -lt 11 ]; then
    # shellcheck disable=SC2086
    sed -i 's|^deb\(-src\)\{0,1\} http|deb\1 [trusted=yes] http|' $files 2>/dev/null || true
fi
