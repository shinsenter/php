#!/usr/bin/env bash
################################################################################
#     These setups are part of the project: https://code.shin.company/php
#     Please respect the intellectual effort that went into creating them.
#     If you use or copy these ideas, proper credit would be appreciated.
#      - Author:  Mai Nhut Tan <shin@shin.company>
#      - License: https://code.shin.company/php/blob/main/LICENSE
################################################################################
config="${1:-/etc/apache2/mods-enabled/mpm_tuning.conf}"
profile="${2:-${APACHE_MPM_PROFILE:-balanced}}"

if ! has-cmd apache2; then
    echo "Error: apache2 command not found" >&2
    exit 1
fi

cpu_cores=$(container-limits cpu)
ram_mb=$(container-limits ram)

if apache2 -M 2>/dev/null | grep -qF -- mpm_prefork; then
    mpm_module='prefork'
else
    mpm_module='event'
fi

# adjustment factors per profile
case "$profile" in
  low)
    factor_start=1
    factor_spare=1
    factor_clients=0.5
    ;;
  high)
    factor_start=5
    factor_spare=4
    factor_clients=2
    ;;
  *) # balanced, and any unknown profile
    factor_start=2
    factor_spare=2
    factor_clients=1
    ;;
esac

if [ "$mpm_module" = "prefork" ]; then
    start_servers=$((cpu_cores * factor_start))
    min_spare_servers=$((cpu_cores * factor_spare))
    max_spare_servers=$((cpu_cores * factor_spare * 2))
    max_clients=$(awk "BEGIN {printf \"%d\", $ram_mb / 10 * $factor_clients}")
    [ "$max_clients" -ge 1 ] || max_clients=1
    max_requests_per_child=1000
    server_limit=$max_clients

    cat <<EOF > "$config"
<IfModule mpm_${mpm_module}_module>
    ServerLimit $server_limit
    StartServers $start_servers
    MinSpareServers $min_spare_servers
    MaxSpareServers $max_spare_servers
    MaxRequestWorkers $max_clients
    MaxConnectionsPerChild $max_requests_per_child
</IfModule>
EOF

else
    start_servers=$((cpu_cores * factor_start))
    min_spare_threads=$((cpu_cores * factor_spare * 5))
    max_spare_threads=$((cpu_cores * factor_spare * 10))
    threads_per_child=25
    # a multiple of ThreadsPerChild, and at least one child
    max_clients=$(awk "BEGIN {printf \"%d\", int($ram_mb / 10 * $factor_clients / $threads_per_child) * $threads_per_child}")
    [ "$max_clients" -ge "$threads_per_child" ] || max_clients=$threads_per_child
    # one spare child, so a graceful restart can start new ones while old ones finish
    server_limit=$((max_clients / threads_per_child + 1))

    cat <<EOF > "$config"
<IfModule mpm_${mpm_module}_module>
    ServerLimit $server_limit
    StartServers $start_servers
    MinSpareThreads $min_spare_threads
    MaxSpareThreads $max_spare_threads
    ThreadsPerChild $threads_per_child
    MaxRequestWorkers $max_clients
    MaxConnectionsPerChild 0
</IfModule>
EOF
fi
