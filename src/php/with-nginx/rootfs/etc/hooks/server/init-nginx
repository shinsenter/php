nginx-conf 'user' "$APP_USER $APP_GROUP"
nginx-conf 'pid'  "${NGINX_PID:-/run/nginx.pid}"

# set variables
echo "
set \$APP_PATH '$APP_PATH';
set \$APP_ROOT '$APP_ROOT';
" >/etc/nginx/custom.d/00-set-variables.conf

# health checks on their own port, so they answer for any Host header, without TLS and apart from the app routes
# the port is not exposed: orchestrators call it on the container address, so it must listen on all addresses
HEALTH_PORT="${HEALTH_PORT:-2020}"
PING_PATH="${PHP_PING_PATH:-/ping}"
cat >/etc/nginx/sites-enabled/01-health.conf <<HEALTHCONF
server {
    listen ${HEALTH_PORT};
    listen [::]:${HEALTH_PORT};
    access_log off;

    # /healthz answers without PHP, so it tells that the web server is up
    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # /readyz asks PHP-FPM for its ping page, so it tells that PHP can serve requests
    location = /readyz {
        include fastcgi_params;
        fastcgi_pass @php;
        fastcgi_param SCRIPT_NAME     ${PING_PATH};
        fastcgi_param SCRIPT_FILENAME ${PING_PATH};
    }

    location / {
        return 404;
    }
}
HEALTHCONF

# trust X-Forwarded-For and X-Forwarded-Proto from more proxies (CIDRs separated by comma or space)
# this works only when real_ip is built in, because the same directive decides who is trusted
\rm -f /etc/nginx/proxies.d/trusted.conf
if [ -n "$TRUSTED_PROXIES" ] && grep -q '^[[:space:]]*real_ip_header' /etc/nginx/nginx.conf; then
    for cidr in $(echo "$TRUSTED_PROXIES" | tr ',' ' '); do
        case "$cidr" in
            *[!0-9a-fA-F:./]*) debug-echo -w "Skip invalid TRUSTED_PROXIES entry: $cidr" ;;
            *) echo "set_real_ip_from $cidr;" >>/etc/nginx/proxies.d/trusted.conf ;;
        esac
    done
fi

# adjust max upload size
if [ -n "$PHP_POST_MAX_SIZE" ]; then
    echo "client_max_body_size ${PHP_POST_MAX_SIZE};" >/etc/nginx/custom.d/00-client_max_body_size.conf
fi

# adjust max timeout
if [ -n "$PHP_MAX_EXECUTION_TIME" ] && [ "$PHP_MAX_EXECUTION_TIME" -gt "0" ]; then
    echo "
send_timeout        ${PHP_MAX_EXECUTION_TIME};
client_body_timeout ${PHP_MAX_EXECUTION_TIME};
" >/etc/nginx/custom.d/00-client_body_timeout.conf

    echo "
proxy_connect_timeout ${PHP_MAX_EXECUTION_TIME};
proxy_read_timeout    ${PHP_MAX_EXECUTION_TIME};
proxy_send_timeout    ${PHP_MAX_EXECUTION_TIME};
" >/etc/nginx/custom.d/00-proxy_timeout.conf
fi

web-chown fix /var/lib/nginx /var/log/nginx /run/nginx

# the dhparam file is created at build time, a volume on /etc/ssl/site can hide it
if [ -f /etc/ssl/site/dhparam.pem ]; then
    nginx-conf 'ssl_dhparam' '/etc/ssl/site/dhparam.pem'
else
    debug-echo -w "Disable ssl_dhparam because /etc/ssl/site/dhparam.pem is missing"
    nginx-conf '#ssl_dhparam' '/etc/ssl/site/dhparam.pem'
fi

# listen on IPv6 only when the kernel supports it
if [ -e /proc/net/if_inet6 ]; then
    sed -i 's/^\([[:space:]]*\)# listen \[::\]/\1listen [::]/' /etc/nginx/sites-enabled/*.conf /etc/nginx/custom.d/*.conf >/dev/null 2>&1
else
    debug-echo -w "Disable listening on IPv6 because the kernel does not support it"
    sed -i 's/^\([[:space:]]*\)listen \[::\]/\1# listen [::]/' /etc/nginx/sites-enabled/*.conf /etc/nginx/custom.d/*.conf >/dev/null 2>&1
fi

# enable debug logs
if is-debug; then
    nginx-conf 'error_log' "$(log-path stdout) debug"
    debug-echo -w "🐞 Nginx is in DEBUG MODE 🐞"
else
    nginx-conf 'error_log' "$(log-path stderr) error"
fi

if ! is-true "$DISABLE_GREETING" && has-cmd nginx; then
    nginx -v 2>&1
fi

exec with-env nginx -t
