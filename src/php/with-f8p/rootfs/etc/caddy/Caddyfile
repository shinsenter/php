{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	# Let running requests finish on stop, within the s6 stop timeout
	grace_period {$CADDY_GRACE_PERIOD:20s}

	# Trust X-Forwarded-For and X-Forwarded-Proto only from TRUSTED_PROXIES
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES}
		# Close connections that send their request headers too slowly
		timeouts {
			read_header {$CADDY_READ_HEADER_TIMEOUT:10s}
		}
	}

	frankenphp {
		# worker {$APP_ROOT}/index.php
		{$FRANKENPHP_CONFIG}
	}

	log {
		level {$CADDY_LOG_LEVEL:WARN}
		# format filter {
		# 	request>uri query {
		# 		replace authorization REDACTED
		# 	}
		# }
	}
}

{$CADDY_EXTRA_CONFIG}

# Health checks on their own port, so they answer for any Host header and without TLS
http://:{$HEALTH_PORT:2020} {
	respond /healthz "ok" 200
	respond /readyz "ok" 200
	respond 404
}

# Same headers as the nginx and apache images, and no server name in responses
(security-headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy {$CADDY_REFERRER_POLICY:strict-origin-when-cross-origin}
		-Server
	}
}

# Hide dotfiles such as .env and .git, except .well-known, as the nginx and apache images do
(deny-dotfiles) {
	@dotfiles {
		path_regexp (^|/)\.
		not path /.well-known/*
	}
	respond @dotfiles 404
}

http://{$SERVER_NAME:localhost} {
	root * {$APP_ROOT}
	# Compressed SSE streams cost memory per subscriber and enable BREACH-style attacks.
	@compressible not path /.well-known/mercure
	encode @compressible zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}
	import Caddyfile.server.d/*.caddyfile
	import deny-dotfiles
	import security-headers

	php_server
}

{$SERVER_NAME:localhost} {
	tls /etc/ssl/site/server.crt /etc/ssl/site/server.key

	root * {$APP_ROOT}
	# Compressed SSE streams cost memory per subscriber and enable BREACH-style attacks.
	@compressible not path /.well-known/mercure
	encode @compressible zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}
	import Caddyfile.server.d/*.caddyfile
	import deny-dotfiles
	import security-headers

	php_server
}

import Caddyfile.d/*.caddyfile

