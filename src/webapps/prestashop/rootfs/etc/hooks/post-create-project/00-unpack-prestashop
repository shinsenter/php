# The PrestaShop download holds prestashop.zip with the shop inside.
# The zip also holds a large index.php, so unpack apart and copy over it.
cd "$APP_PATH" || exit 0
[ -f prestashop.zip ] || exit 0

debug-echo -i "Unpack prestashop.zip in $APP_PATH."
tmp="$(mktemp -d)"
unzip -q prestashop.zip -d "$tmp"
cp -rpf "$tmp"/. "$APP_PATH"/
rm -rf "$tmp" prestashop.zip Install_PrestaShop.html
debug-echo -s "PrestaShop is unpacked in $APP_PATH."
