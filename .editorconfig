root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2

[*.patch]
trim_trailing_whitespace = false

[Caddyfile]
indent_style = tab
indent_size = 2
insert_final_newline = false
